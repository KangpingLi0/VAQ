+def _ensure_internlm2_generation_compat(model):
+    """Bridge old InternLM2 remote code to modern Transformers generation.
+
+    Transformers 4.50 stopped making every PreTrainedModel inherit
+    GenerationMixin, while InternVL2/2.5 checkpoints still rely on that old
+    behavior.  Newer generation code may also provide an unpopulated legacy
+    KV-cache container on its first step.  Apply both compatibility fixes once
+    at model load so every lmms task and every quantization method sees the
+    same corrected language model.
+    """
+    language_model = model.language_model
+    if not hasattr(language_model, "generate"):
+        from transformers.generation import GenerationConfig, GenerationMixin
+
+        compat_class = type(
+            f"{language_model.__class__.__name__}WithGenerationMixin",
+            (language_model.__class__, GenerationMixin),
+            {},
+        )
+        language_model.__class__ = compat_class
+        if getattr(language_model, "generation_config", None) is None:
+            language_model.generation_config = GenerationConfig.from_model_config(
+                language_model.config
+            )
+
+    if getattr(language_model, "_qig_generation_compat", False):
+        return model
+
+    original_prepare = language_model.prepare_inputs_for_generation
+
+    def prepare_inputs_for_generation(
+        self,
+        input_ids,
+        past_key_values=None,
+        attention_mask=None,
+        inputs_embeds=None,
+        **kwargs,
+    ):
+        if past_key_values is not None:
+            past_length = 0
+            if hasattr(past_key_values, "get_seq_length"):
+                past_length = past_key_values.get_seq_length()
+            else:
+                try:
+                    first_key = past_key_values[0][0]
+                    if first_key is not None:
+                        past_length = first_key.shape[2]
+                except (IndexError, TypeError, AttributeError):
+                    pass
+            if past_length == 0:
+                past_key_values = None
+        return original_prepare(
+            input_ids,
+            past_key_values=past_key_values,
+            attention_mask=attention_mask,
+            inputs_embeds=inputs_embeds,
+            **kwargs,
+        )
+
+    language_model.prepare_inputs_for_generation = types.MethodType(
+        prepare_inputs_for_generation, language_model
+    )
+    language_model._qig_generation_compat = True
+    return model
+
