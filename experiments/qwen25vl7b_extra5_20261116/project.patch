+"""Controlled LAT-AWQ core ablations: one public checkpoint, matched calibration and evaluation."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+import time
+from types import SimpleNamespace
+
+SOURCE = Path(__file__).resolve().parent
+sys.path.insert(0, str(SOURCE))
+OUT = Path('/data/lkp/VAQ/outputs/lat_awq_general_20261107')
+MODEL = '/data/lkp/models/Qwen2.5-VL-7B-Instruct'
+
+
+def save(path, value):
+    path = Path(path);path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(path.suffix + '.tmp')
+    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2));temporary.replace(path)
+
+
+def cache_path(args):
+    return OUT / f'calibration_n{args.n}_seed{args.seed}.pt'
+
+
+def name(args):
+    return f'w{args.w}a{args.a}_{args.variant}_seed{args.seed}' + ('_smoke' if args.n == 2 else '')
+
+
+def load_model():
+    import torch
+    import torch_npu
+    from transformers import AutoProcessor, Qwen2_5_VLForConditionalGeneration
+    from qmllm.models import get_process_model
+    torch.set_num_threads(8)
+    torch.npu.set_device(0)
+    model = Qwen2_5_VLForConditionalGeneration.from_pretrained(
+        MODEL, torch_dtype=torch.float16, attn_implementation='sdpa', local_files_only=True).eval()
+    print('[general] model loaded on CPU; moving to NPU', flush=True)
+    model = model.to('npu:0')
+    print('[general] model moved; loading processor', flush=True)
+    processor = AutoProcessor.from_pretrained(MODEL, min_pixels=200704, max_pixels=1605632,
+                                               use_fast=True, local_files_only=True)
+    adapter = get_process_model('qwen2_5_vl')(model, processor.tokenizer, processor)
+    adapter.set_device('npu:0')
+    print('[general] model and processor ready', flush=True)
+    return model, processor, adapter
+
+
+def calibrate(args):
+    import torch
+    from qmllm.calibration.coco_vl import get_multimodal_calib_dataset
+    if cache_path(args).exists():
+        return
+    model, processor, adapter = load_model()
+    selection = OUT / f'calibration_n128_seed{args.seed}.json'
+    inputs, kwargs = get_multimodal_calib_dataset(str(selection), '', adapter, n_samples=args.n,
+                                                 micro_bs=1, shuffle=False, image_size=None)
+    assert inputs['inputs_embeds'].shape[0] == args.n, 'calibration sample count changed'
+    assert torch.isfinite(inputs['inputs_embeds']).all(), 'non-finite calibration embeddings'
+    destination = cache_path(args);temporary = destination.with_suffix('.tmp')
+    torch.save({'prompt_inputs': inputs, 'prompt_kwargs': kwargs}, temporary);temporary.replace(destination)
+    save(destination.with_suffix('.meta.json'), {
+        'model': MODEL, 'cases': args.n, 'seed': args.seed, 'selection': str(selection),
+        'shape': list(inputs['inputs_embeds'].shape), 'min_pixels': 200704, 'max_pixels': 1605632,
+        'selection_sha256': hashlib.sha256(selection.read_bytes()).hexdigest(),
+    })
+
+
+def quantize(args):
+    import torch
+    from transformers import Qwen2_5_VLForConditionalGeneration
+    from qmllm.quantization.quant_wrapper import qwrapper
+    from qmllm.utils.hf_compat import get_qwen_vl_layers
+    torch.manual_seed(args.seed)
+    run = OUT / name(args);run.mkdir(exist_ok=True)
+    if (run / 'quantization.json').exists() and (run / 'quantized_state.pt').exists():
+        return
+    model, processor, adapter = load_model()
+    cache = torch.load(str(cache_path(args)), map_location='cpu', weights_only=True, mmap=True)
+    cache_metadata = json.loads(cache_path(args).with_suffix('.meta.json').read_text())
+    selection = OUT / f'calibration_n128_seed{args.seed}.json'
+    assert cache_metadata['selection_sha256'] == hashlib.sha256(selection.read_bytes()).hexdigest(), 'calibration selection changed'
+    assert cache['prompt_inputs']['inputs_embeds'].shape[0] == args.n, 'wrong calibration cache'
+    s, l = {'A': (False, False), 'B': (True, False), 'C': (False, True), 'D': (True, True)}[args.variant]
+    options = SimpleNamespace(method='lat_awq', model='qwen2_5_vl', model_args=f'pretrained={MODEL}',
+        w_bit=args.w, a_bit=args.a, w_group=128, alpha=.5, run_process=True, pseudo_quant=False,
+        reweight=False, distort=False, loss_mode='mse', scale_path=str(run / 'scales.pt'),
+        torch_device=torch.device('npu:0'), token_aware_saliency=s, token_weighted_loss=l,
+        saliency_mix_lambda=.5, lat_debug=True, lat_log_dir=str(run / 'search_logs'),
+        lat_output_dir=str(run / 'search_metadata'), effective_n_samples=args.n, seed=args.seed)
+    started = time.time()
+    before = get_qwen_vl_layers(model)[0].self_attn.q_proj.weight[:1].detach().cpu().clone()
+    save(run / 'configuration.json', {
+        'variant': args.variant, 's': s, 'l': l, 'lambda': .5, 'w_bit': args.w, 'a_bit': args.a,
+        'n': args.n, 'calibration_seed': args.seed, 'ig_steps': 32,
+        'calibration_selection_sha256': cache_metadata['selection_sha256'],
+        'weight_quantizer': 'symmetric_absmax_per_channel' if args.a < 16 else 'asymmetric_group_128',
+        'activation_quantizer': 'dynamic_symmetric_absmax_per_token' if args.a < 16 else 'FP16',
+        'quantization_scope': 'decoder linear layers only; vision encoder, embeddings and lm_head FP16',
+        'mask_policy': 'same valid vision+answer token pool; padding excluded in statistics, IG, IQR and loss',
+        'sample_weighting': 'equal mass per calibration case',
+        'reconstruction_arithmetic': ('shared strict FP32 subtraction and squared error for every S/L setting'
+                                    if args.a == 16 else 'shared repository W/A reconstruction routine for every S/L setting'),
+        'wa_gradient_mode': 'existing stop-gradient quantized branch; common to all W4A8 variants',
+        'model': MODEL, 'min_pixels': 200704, 'max_pixels': 1605632,
+        'comparison_policy': 'all four variants use identical data, quantizer, search grid and evaluation settings',
+        'full_method_is_fresh_run': True,
+    })
+    qwrapper(adapter, cache['prompt_inputs'], cache['prompt_kwargs'], options)
+    search_seconds = time.time() - started
+    adapter.to_cpu()
+    original = Qwen2_5_VLForConditionalGeneration.from_pretrained(
+        MODEL, torch_dtype=torch.float16, attn_implementation='sdpa', local_files_only=True)
+    adapter.model.load_state_dict(original.state_dict(), strict=True);del original
+    options.run_process = False;options.pseudo_quant = True
+    qwrapper(adapter, None, None, options)
+    after = get_qwen_vl_layers(adapter.model)[0].self_attn.q_proj.weight[:1].detach().cpu()
+    assert not torch.equal(before, after), 'quantization did not change weights'
+    groups = after.reshape(-1, 128) if args.a == 16 else after.reshape(1, -1)
+    assert all(group.unique().numel() <= 2 ** args.w for group in groups), 'weight values do not match requested bit grid'
+    for layer in get_qwen_vl_layers(adapter.model):
+        for module in layer.modules():
+            if hasattr(module, 'weight'):
+                assert torch.isfinite(module.weight).all(), 'non-finite quantized parameters'
+    temporary = run / 'quantized_state.tmp'
+    torch.save({key: value.detach().cpu() for key, value in adapter.model.state_dict().items()}, temporary)
+    temporary.replace(run / 'quantized_state.pt')
+    save(run / 'quantization.json', {'complete': True, 'search_seconds': search_seconds,
+         'total_seconds': time.time() - started, 'representation': 'fake-quantized FP16 tensors',
+         'activation_wrappers': sum(type(m).__name__ == 'WALinear' for m in adapter.model.modules()),
+         'reference_weight_changed': True, 'calibration_cases': args.n,
+         'reference_weight_bit_grid_verified': True,
+         'configuration': json.loads((run / 'configuration.json').read_text())})
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('mode', choices=['calibration', 'quant'])
+    parser.add_argument('--variant', choices=['A', 'B', 'C', 'D'], default='D')
+    parser.add_argument('--w', type=int, default=3);parser.add_argument('--a', type=int, default=16)
+    parser.add_argument('--n', type=int, default=128);parser.add_argument('--seed', type=int, default=42)
+    args = parser.parse_args()
+    if args.mode == 'calibration':calibrate(args)
+    else:quantize(args)
+
+
+if __name__ == '__main__':
+    main()
