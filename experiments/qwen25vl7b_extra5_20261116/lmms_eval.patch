+"""MMT-Bench VAL using the official VLMEvalKit prompt and exact matching."""
+import string
+from statistics import mean
+from lmms_eval.tasks.mmt_bench_val.official_matching import can_infer
+
+
+def choices(doc):
+    return {letter:str(doc[letter]) for letter in string.ascii_uppercase
+            if letter in doc and doc[letter] is not None and str(doc[letter])!=''}
+
+
+def doc_to_visual(doc):
+    images=doc['image']
+    if not isinstance(images,list):images=[images]
+    return [image.convert('RGB') for image in images]
+
+
+def doc_to_text(doc):
+    # Matches ImageMCQDataset.build_prompt in the pinned VLMEvalKit reference.
+    options=choices(doc)
+    hint=doc.get('hint')
+    prompt=f'Hint: {hint}\n' if hint is not None and hint!='' else ''
+    prompt+=f'Question: {doc["question"]}\n'
+    if options:
+        prompt+='Options:\n'+''.join(f'{key}. {value}\n' for key,value in options.items())
+        prompt+='Please select the correct answer from the options above. \n'
+    return prompt
+
+
+def process_results(doc,results):
+    prediction=can_infer(results[0],choices(doc)) or 'Z'
+    answer=str(doc['answer']).strip().upper()
+    return {'mmtbench_accuracy':{'index':doc['index'],'prediction':results[0],
+        'predicted_option':prediction,'answer':answer,'correct':prediction==answer,
+        'category':doc.get('category'),'l2-category':doc.get('l2-category')}}
+
+
+def aggregate_results(results):
+    assert results
+    return mean(float(row['correct']) for row in results)
